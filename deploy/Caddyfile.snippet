# Die LIVE-Blöcke (seit 2026-09-20 Launch, Spiegel der Hub-Caddyfile).
# Originale: ~/caddy/Caddyfile auf dem Hub (Backups: bak-pre-mcpclinicdev-,
# bak-pre-mcpcliniclaunch-20260920). Achtung: reverse_proxy über 172.25.0.1
# (Docker-Bridge-GW) — ufw erlaubt 172.16.0.0/12 → Port 3300.

mcpclinic.dev {
	reverse_proxy 172.25.0.1:3300
}

www.mcpclinic.dev {
	redir https://mcpclinic.dev{uri} permanent
}

mcpclinic.de {
	redir https://mcpclinic.dev{uri} permanent
}

www.mcpclinic.de {
	redir https://mcpclinic.dev{uri} permanent
}

# Review-Instanz (noindex) — bleibt neben der Live-Site für Iterationen:
mcpclinic-dev.kills.dog {
	import noindex
	reverse_proxy 172.25.0.1:3300
}
